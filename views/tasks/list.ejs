<% layout('layout') -%>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Real‑World Tasks</h3>
</div>
<div class="row g-3">
  <% tasks.forEach(t=>{ %>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <h5><a href="/tasks/<%= t.id %>" class="stretched-link text-decoration-none text-success"> <%= t.title %> </a></h5>
        <p class="text-muted">
          <%= t.description.split(' ').slice(0, 30).join(' ') %><%= t.description.split(' ').length > 30 ? '...' : '' %>
        </p>
        <span class="badge bg-success">+<%= t.points %> pts</span>
        <div class="mt-2">
          <a class="btn btn-outline-success btn-sm" href="/tasks/<%= t.id %>/submit">Submit Proof</a>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
</div>
