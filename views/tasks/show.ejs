<% layout('layout') -%>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <!-- Task Card -->
      <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
          <span><i class="bi bi-check-circle-fill me-2"></i><%= task.title %></span>
          <span class="badge bg-light text-success fs-6">Points: <%= task.points %></span>
        </div>
        <div class="card-body">
          <!-- Task Description / Steps -->
          <h6 class="fw-semibold mb-3">Steps to Complete:</h6>
          <p class="text-muted"><%= task.description %></p>

          <!-- Task Images -->
          <!-- <%// if(task.images && task.images.length > 0) { %>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <%// task.images.forEach(img => { %>
            <img src="<%=// img %>" class="img-thumbnail shadow-sm" style="max-width: 150px; height: auto; object-fit: cover" />
            <%// }) %>
          </div>
          <%// } %> -->
          <div class="d-flex flex-wrap gap-2 mb-3">
            <img
              src="\images\vecteezy_human-hand-and-seedling-nature-background-concept-planting_13395787.jpg"
              class="img-thumbnail shadow-sm"
              style="max-width: 340px; height: auto; object-fit: cover"
              alt=""
            />
            <img
              src="\images\vecteezy_human-hand-and-seedling-nature-background-concept-planting_13395787.jpg"
              class="img-thumbnail shadow-sm"
              style="max-width: 340px; height: auto; object-fit: cover"
              alt=""
            /><img
              src="\images\vecteezy_human-hand-and-seedling-nature-background-concept-planting_13395787.jpg"
              class="img-thumbnail shadow-sm"
              style="max-width: 340px; height: auto; object-fit: cover"
              alt=""
            /><img
              src="\images\vecteezy_human-hand-and-seedling-nature-background-concept-planting_13395787.jpg"
              class="img-thumbnail shadow-sm"
              style="max-width: 340px; height: auto; object-fit: cover"
              alt=""
            />
          </div>

          <!-- Mark Task Complete Button -->
          <form action="/tasks/<%= task.id %>/complete" method="post" class="mt-3">
            <button class="btn btn-success w-100">Mark Task Complete (+<%= task.points %> pts)</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
