<% layout('layout') -%>

<div class="container py-4">
  <h2 class="mb-4 fw-bold text-success">
    <i class="bi bi-speedometer2"></i> Student Dashboard
  </h2>

  <div class="row g-4">
    <!-- Leaderboard -->
    <div class="col-md-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-success text-white fw-bold">
          <i class="bi bi-trophy-fill"></i> Leaderboard (Top 10)
        </div>
        <div class="card-body">
          <ol class="mb-0 ps-3">
            <% leaderboard.forEach((p, i) => { %>
              <li class="mb-1">
                <span class="fw-semibold"><%= p.name %></span> 
                <span class="badge bg-success rounded-pill"><%= p.score %> pts</span>
              </li>
            <% }) %>
          </ol>
        </div>
      </div>
    </div>

    <!-- Progress + Actions -->
    <div class="col-md-8">
      <!-- Progress -->
      <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-light fw-bold">
          <i class="bi bi-graph-up-arrow text-success"></i> Your Progress
        </div>
        <div class="card-body">
          <p class="mb-2">Lessons completed: 
            <strong><%= completed_lessons.length %></strong>
            <div class="progress">
              <div class="progress-bar bg-success" style="width: <%= (completed_lessons.length/10)*100 %>%"></div>
            </div>
          </p>
          <p class="mb-2">Quizzes attempted: 
            <strong><%= completed_quizzes.length %></strong>
            <div class="progress">
              <div class="progress-bar bg-info" style="width: <%= (completed_quizzes.length/10)*100 %>%"></div>
            </div>
          </p>
          <p class="mb-2">Tasks submitted: 
            <strong><%= tasks.length %></strong>
            <div class="progress">
              <div class="progress-bar bg-warning" style="width: <%= (tasks.length/10)*100 %>%"></div>
            </div>
          </p>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h5 class="fw-bold mb-3">
            <i class="bi bi-lightning-fill text-warning"></i> Quick Actions
          </h5>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-success" href="/lessons">
              <i class="bi bi-journal-text"></i> Lessons
            </a>
            <a class="btn btn-info text-white" href="/quizzes">
              <i class="bi bi-question-circle"></i> Quizzes
            </a>
            <a class="btn btn-warning text-white" href="/tasks">
              <i class="bi bi-check2-circle"></i> Tasks
            </a>
            <a class="btn btn-primary" href="/games">
              <i class="bi bi-controller"></i> Games
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
