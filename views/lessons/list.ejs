<% layout('layout') -%>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Lessons</h3>
  <% if (user.role === 'teacher' || user.role === 'admin') { %>
  <a class="btn btn-success" href="/lessons/create/new">Create Lesson</a>
  <% } %>
</div>
<div class="row g-3">
  <% lessons.forEach(l => { const res = JSON.parse(l.resources||'[]'); %>
  <!-- C:\Code\Projects\Environmental-Education-prototype\public\css\images\vecteezy_human-hand-and-seedling-nature-background-concept-planting_13395787.jpg -->
  <div class="col-md-4">
    <div class="card h-100 shadow-sm">
      <!-- Thumbnail -->
      <img
        src="images/vecteezy_human-hand-and-seedling-nature-background-concept-planting_13395787.jpg"
        class="card-img-top"
        alt="<%= l.title %> thumbnail"
      />

      <!-- Card body -->
      <div class="card-body">
        <h5 class="card-title">
          <a href="/lessons/<%= l.id %>" class="stretched-link text-decoration-none text-success"> <%= l.title %> </a>
        </h5>
        <p class="text-muted"><%= l.description %></p>
        <span class="badge bg-secondary"><%= res.length %> resource(s)</span>
      </div>
    </div>
  </div>

  <% }) %>
</div>
